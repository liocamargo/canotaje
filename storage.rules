rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cualquier usuario autenticado puede subir/leer comprobantes de inscripción.
    // La autorización real (¿es staff del club?) la hace Firestore antes de mostrar
    // la UI para subir archivos; esta regla sólo evita que un usuario anónimo escriba.
    match /comprobantes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
