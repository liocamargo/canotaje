rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Comprobante de inscripción y comprobante de pago se pueden subir desde
    // formularios públicos (sin login) además de desde el panel, por eso permiten
    // escritura anónima. La lectura queda restringida a usuarios autenticados.
    match /socios-docs/comprobantes/{allPaths=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    match /socios-docs/comprobantes-pago/{allPaths=**} {
      allow write: if true;
      allow read: if request.auth != null;
    }
    // Ficha médica y deslinde de responsabilidad sólo se suben desde el panel
    // (staff logueado), no hay formulario público para estos.
    match /socios-docs/{tipo}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
